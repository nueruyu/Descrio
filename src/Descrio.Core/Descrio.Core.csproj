<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UnityProjectRoot>..\..\Descrio.Unity</UnityProjectRoot>
    <RootNamespace>Descrio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <Target Name="CopyOutputToDestination" AfterTargets="Build">
    <Message Text="--- Copying DLL to destination folder ---" Importance="high" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityProjectRoot)\Packages\com.nueruyu.descrio\Runtime" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
